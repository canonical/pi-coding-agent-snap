#!/bin/sh
# SPDX-FileCopyrightText: Canonical Ltd.
# SPDX-License-Identifier: MIT
#
# Wrapper script for pi that unsets SNAP environment variables and execs
# the bundled Node.js runtime against pi's CLI entry point. Pi's built-in
# tools (bash, read, write, edit) should operate in the user's environment,
# not the snap sandbox environment.
#
# Based on the same pattern used by opencode-snap.

. "$SNAP/bin/node-exec.sh"

# Expose the snap-staged clipboard tools (wl-copy/wl-paste) to pi, which
# spawns them by bare name. Classic snaps inherit the host PATH and
# snapd adds nothing, so without this the staged binaries are unreachable
# on hosts without a host-installed wl-clipboard. Prepend so the snap's
# copies take precedence.
PATH="$SNAP/usr/bin:$PATH"
export PATH

node_exec "$SNAP/lib/pi/packages/coding-agent/dist/cli.js" "$@"
