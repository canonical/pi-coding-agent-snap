#!/bin/sh
# SPDX-FileCopyrightText: Canonical Ltd.
# SPDX-License-Identifier: MIT
#
# Wrapper script for pi that unsets SNAP environment variables and execs
# the bundled Node.js runtime against pi's CLI entry point. Pi's built-in
# tools (bash, read, write, edit) should operate in the user's environment,
# not the snap sandbox environment.
#
# Based on the same pattern used by opencode-snap.

NODE="$SNAP/node/bin/node"
CLI="$SNAP/lib/pi/packages/coding-agent/dist/cli.js"
# Expose the snap-staged clipboard tools (wl-copy/wl-paste) to pi, which
# spawns them by bare name. Classic snaps inherit the host PATH and
# snapd adds nothing, so without this the staged binaries are unreachable
# on hosts without a host-installed wl-clipboard. Prepend so the snap's
# copies take precedence.
PATH="$SNAP/usr/bin:$PATH"
export PATH

# snapd gives classic snaps a complain-mode (log-only) AppArmor profile whose
# label is inherited by everything pi spawns. If a child is itself a snap
# (e.g. `juju debug-log > file`), snap-confine rejects file descriptors that
# were opened under pi's label, so redirection fails with "bad file
# descriptor" (issue #26, LP: #1849753). Arm AppArmor's onexec transition so
# node, and everything it spawns, runs unconfined as it would outside the
# snap. Only act under our own complain-mode label; ignore any failure.
if [ -e /proc/self/attr/apparmor/current ]; then
    ATTR_DIR=/proc/self/attr/apparmor
else
    ATTR_DIR=/proc/self/attr
fi
LABEL=
{ read -r LABEL < "$ATTR_DIR/current"; } 2>/dev/null || :
case "$LABEL" in
    "snap.${SNAP_INSTANCE_NAME:-pi-coding-agent}."*" (complain)")
        { printf 'exec unconfined' > "$ATTR_DIR/exec"; } 2>/dev/null || :
        ;;
esac
unset ATTR_DIR LABEL

# Unset all environment variables starting with SNAP
for var in $(env | cut -d= -f1 | grep '^SNAP'); do
    unset "$var"
done

# llhttp's WASM SIMD build (used by pi's bundled undici for HTTP/1.1
# response parsing) misparses responses on riscv64 with spurious
# "Invalid header value char" errors, surfacing as intermittent
# "Connection error" failures. undici disables the SIMD build on ppc64
# for the same reason; force the non-SIMD wasm build on riscv64.
if [ "$(uname -m)" = "riscv64" ]; then
    export UNDICI_NO_WASM_SIMD=1
fi

exec "$NODE" "$CLI" "$@"